rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read and write for site images (no Firebase Auth required in this implementation).
    match /site_images/{imageId} {
      allow read, write: if true;
    }

    // Fallback: deny everything else by default.
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
